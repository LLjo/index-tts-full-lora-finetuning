# Copy to `.env.indextts` and edit. `scripts/serve_ha.py` reads it on startup.
# Already-set environment variables win, so this file is overridable.

# --- API server ---
INDEXTTS_API_HOST=0.0.0.0
INDEXTTS_API_PORT=8000

# --- Wyoming bridge (what HA talks to) ---
INDEXTTS_WYOMING_PORT=10200

# --- Default speaker loaded at startup. Comment out to skip and let the
#     bridge lazy-load on the first HA request. ---
INDEXTTS_DEFAULT_SPEAKER=ozzyv6

# --- Streaming preset used for HA queries. Tradeoff:
#     fast_quality        — low TTFA + big steady chunks for quality
#     ultra_fast_distilled — sub-200ms TTFA (needs an active distilled student)
#     balanced_distilled  — ~250-300ms TTFA, sentence-paced, highest quality
INDEXTTS_STREAMING_PRESET=fast_quality

# --- Solver overrides. When a distilled student is active these tighten TTFA
#     by skipping the multi-step ODE integration. Leave empty to use whatever
#     the preset chose. ---
INDEXTTS_SOLVER_OVERRIDE=single_step
INDEXTTS_DIFFUSION_STEPS_OVERRIDE=1
INDEXTTS_CFG_OVERRIDE=0.0

# --- Reference audio ---
# The TTS pipeline needs a reference clip to extract speaker conditioning
# (timbre / pitch / pacing) at inference. The bridge resolves it in this order:
#
#   1. If INDEXTTS_REFERENCE_AUDIO is set, the bridge uploads that file on
#      every HA request. The API caches conditioning by path, so per-request
#      cost drops to ~2ms after the first call.
#
#   2. Else the bridge auto-picks the first audio clip from
#      training/<speaker>/dataset/audio/ and uploads it. Same caching behavior.
#
#   3. If training/<speaker>/embeddings/speaker_embeddings.pt exists, the
#      API loads it instead of re-extracting from audio. In theory this skips
#      the upload entirely, BUT in practice on this codebase the audio-upload
#      path tends to be both faster and audibly cleaner — extract_embeddings
#      doesn't capture every derived tensor the audio path computes fresh
#      (notably gpt_conditioning / emo_vec), and the .pt load itself has
#      historically cost ~100-300ms per request. The API now in-process-caches
#      the parsed dict so the second call is fast, but the quality gap
#      remains. Skip this path unless you're sure it sounds right on your
#      speaker.
#
# Recommended: leave the comment below in place and let auto-pick handle it.
# Override only if you want a fixed exemplar for every speaker.
#INDEXTTS_REFERENCE_AUDIO=/abs/path/to/clean_exemplar.wav

# --- Voice metadata advertised to HA ---
INDEXTTS_LANGUAGE=en
INDEXTTS_ATTRIB_NAME=IndexTTS2
INDEXTTS_ATTRIB_URL=https://github.com/index-tts/index-tts

# --- Timeouts (rarely change) ---
INDEXTTS_HEALTH_TIMEOUT_S=180
INDEXTTS_LOAD_TIMEOUT_S=600
INDEXTTS_LOG_LEVEL=INFO
